{
  "name": "civicconnect",
  "version": "0.1.0",
  "description": "CivicConnect - community service request management platform (SEN381)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "build": "node scripts/build-check.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:perf": "node scripts/perf-test.js",
    "test:integration": "node --env-file-if-exists=.env --test \"tests/integration/**/*.test.js\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
