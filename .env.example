# Copy to .env for local development. .env is git-ignored.
# Never put real credentials in this file.
NODE_ENV=development
PORT=3000

# Local docker-compose Postgres (fallback profile, RSK-001) or a Neon dev branch.
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://civicconnect:change-me-locally@localhost:5432/civicconnect

# Owner-role connection used ONLY by `npm run migrate` (never set on the running web service).
MIGRATION_DATABASE_URL=

# Used only by tests/integration; must point at a DISPOSABLE database.
TEST_DATABASE_URL=

# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
